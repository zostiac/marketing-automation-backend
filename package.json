{
  "name": "marketing-automation-backend",
  "version": "1.0.0",
  "description": "AI-powered school marketing automation backend for Amar English School",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && (cp -r src/database/schema.sql dist/database/schema.sql 2>/dev/null || true)",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "migrate": "ts-node src/database/migrations.ts",
    "seed": "ts-node src/scripts/seed-school.ts",
    "seed:school": "ts-node src/scripts/seed-school.ts",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.400.0",
    "axios": "^1.5.0",
    "bull": "^4.11.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nepali-date-converter": "^3.4.0",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.0",
    "openai": "^4.11.1",
    "pg": "^8.10.0",
    "redis": "^4.6.10",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/morgan": "^1.9.5",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.21.0",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "eslint": "^8.46.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  }
}
