# ---------------------------------------------------------------------------
# Backend API — set this in Vercel → Settings → Environment Variables.
#
# NOTE: no NEXT_PUBLIC_ prefix. This is read only on the server (Server
# Components / Route Handlers), so the URL and token never reach the browser
# and there is no CORS to configure.
#
# Use your Railway PUBLIC domain, not *.railway.internal — Vercel functions
# run outside Railway's private network and cannot resolve internal hostnames.
# ---------------------------------------------------------------------------
API_URL=https://marketing-automation-backend-production.up.railway.app

# Optional bearer token, if you protect the backend.
# API_TOKEN=

# Optional: request timeout in ms (default 8000).
# API_TIMEOUT_MS=8000
