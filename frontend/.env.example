# Express backend base URL. Do not include a trailing slash or `/api`.
# In Vercel, use the Railway public domain rather than *.railway.internal.
API_URL=https://marketing-automation-backend-production.up.railway.app

# Required by calendar, school profile, branding, and design-request routes.
# Copy an existing UUID from GET /api/schools (or the Settings page).
SCHOOL_ID=00000000-0000-0000-0000-000000000000

# Optional bearer token. Required when the backend has API_TOKEN set.
# API_TOKEN=

# Optional request timeout in milliseconds (default: 8000).
# API_TIMEOUT_MS=8000
