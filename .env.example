NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Optional bearer token for /api routes. If unset, the API stays public.
# The frontend forwards this as Authorization: Bearer … via API_TOKEN.
# API_TOKEN=
DATABASE_URL=postgresql://user:password@localhost:5432/school_marketing
REDIS_URL=redis://localhost:6379
BUCKET_NAME=school-marketing-assets
BUCKET_REGION=us-east-1
BUCKET_ENDPOINT=https://s3.amazonaws.com
BUCKET_ACCESS_KEY=your_access_key_id
BUCKET_SECRET_KEY=your_secret_access_key
OPENAI_API_KEY=sk-your-api-key-here
# Free-tier ChatGPT model used for creative direction (same chatbot as the web/app free tier)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
IMAGE_GENERATION_PROVIDER=openai
MAX_RETRIES=3
JOB_TIMEOUT_MS=300000
QUALITY_CHECK_ENABLED=true
SCHEDULED_EVENTS_CHECK_TIME=08:00
# Cron expression for due calendar publishing (default every 15 minutes)
PUBLISH_CHECK_CRON=*/15 * * * *

# --- Social media publishing (SocialMediaService) ---
# TODO(pending): credentials not provided yet — to be supplied by the owner.
# Facebook Graph API (Page token + Page ID)
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Instagram Graph API (Business account)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# TikTok Content Posting API v2 (OAuth token with video.publish scope)
TIKTOK_ACCESS_TOKEN=
# Unaudited TikTok apps must use SELF_ONLY until audited
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@amarenglishschool.com

# Analytics
ANALYTICS_ENABLED=true